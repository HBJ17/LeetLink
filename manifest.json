{
  "manifest_version": 3,
  "name": "LeetLink",
  "version": "0.1.0",
  "description": "Push your LeetCode submissions to a GitHub repository.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LeetLink",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
